{
  "dashboard": {
    "id": null,
    "uid": "infra-dashboard",
    "title": "Infrastructure",
    "tags": ["infra", "docker", "monitoring"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "description": "Monitor Docker containers, CPU, memory and uptime",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "type": "timeseries",
        "title": "Container CPU Usage Rate",
        "datasource": {"type": "prometheus", "uid": "prometheus", "name": "Prometheus"},
        "targets": [
          {"expr": "sum(rate(container_cpu_usage_seconds_total[1m])) by (container_label_com_docker_swarm_service_name)", "refId": "A"}
        ]
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "type": "timeseries",
        "title": "Container Memory Usage (Bytes)",
        "datasource": {"type": "prometheus", "uid": "prometheus", "name": "Prometheus"},
        "targets": [
          {"expr": "sum(container_memory_usage_bytes) by (container_label_com_docker_swarm_service_name)", "refId": "A"}
        ]
      },
      {
        "id": 3,
        "gridPos": {"h": 6, "w": 8, "x": 0, "y": 8},
        "type": "stat",
        "title": "Services Up",
        "datasource": {"type": "prometheus", "uid": "prometheus", "name": "Prometheus"},
        "targets": [
          {"expr": "count(up{job=~\"prometheus|mock-metrics|jenkins|cadvisor\"})", "refId": "A"}
        ]
      },
      {
        "id": 4,
        "gridPos": {"h": 6, "w": 8, "x": 8, "y": 8},
        "type": "stat",
        "title": "Services Status",
        "datasource": {"type": "prometheus", "uid": "prometheus", "name": "Prometheus"},
        "targets": [
          {"expr": "sum(up) by (job)", "refId": "A"}
        ]
      },
      {
        "id": 5,
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 14},
        "type": "timeseries",
        "title": "Service Uptime",
        "datasource": {"type": "prometheus", "uid": "prometheus", "name": "Prometheus"},
        "targets": [
          {"expr": "up", "legendFormat": "{{job}}", "refId": "A"}
        ]
      }
    ],
    "annotations": {"list": []}
  },
  "overwrite": true
}

